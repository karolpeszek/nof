Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"draw", " ", "hyperbola"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hiperbola", "=", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "+", "2"}], ")"}], "^", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", "-", "5"}], ")"}], "^", "2"}]}], "]"}], "-", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "-", "3"}], ")"}], "^", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", "-", "2"}], ")"}], "^", "2"}]}], "]"}]}], "]"}], "==",
         "4"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "5"}], ",", "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "2"}], ",", "10"}], "}"}], ",", 
       RowBox[{"ContourStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Purple"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"hiperbola", ",", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
        RowBox[{"Point", "[", "F1", "]"}], ",", 
        RowBox[{"Point", "[", "F2", "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"Axes", "->", "True"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9703960765886927`*^9, 3.970396079829805*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"5eab70f1-40d9-425b-bae5-80962ae3b2ff"],


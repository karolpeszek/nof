  RowBox[{"(*", 
   RowBox[{
   "rotate", " ", "the", " ", "triangle", " ", "by", " ", "30", " ", 
    "degrees", " ", "arroung", " ", "the", " ", "z", " ", "axis"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"Pi", "/", "6"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"30", " ", "stopni"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rotationMatrix", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cos", "[", "theta", "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"Sin", "[", "theta", "]"}]}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", "theta", "]"}], ",", 
         RowBox[{"Cos", "[", "theta", "]"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"aprime", "=", 
     RowBox[{"rotationMatrix", ".", "a"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bprime", "=", 
     RowBox[{"rotationMatrix", ".", "b"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cprime", "=", 
     RowBox[{"rotationMatrix", ".", "c"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trianglePrime", "=", 
     RowBox[{"{", 
      RowBox[{"aprime", ",", "bprime", ",", "cprime", ",", "aprime"}], 
      "}"}]}], ";"}]}]}]], "Input",

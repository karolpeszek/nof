Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"symetralna", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"F2", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", 
         RowBox[{"F1", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"F1", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"F2", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       RowBox[{"M", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "+", 
    RowBox[{"M", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}]], "Input",

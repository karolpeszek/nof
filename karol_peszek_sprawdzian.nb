Cell[BoxData[
 RowBox[{
  RowBox[{"ukladRownan", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{"sigma", " ", "*", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], " ", "-", " ", 
         RowBox[{"x", "[", "t", "]"}]}], ")"}]}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], " ", "*", " ", 
        RowBox[{"(", 
         RowBox[{"rho", " ", "-", " ", 
          RowBox[{"z", "[", "t", "]"}]}], ")"}]}], " ", "-", " ", 
       RowBox[{"y", "[", "t", "]"}]}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"z", "'"}], "[", "t", "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], " ", "*", " ", 
        RowBox[{"y", "[", "t", "]"}]}], " ", "-", " ", 
       RowBox[{"beta", " ", "*", " ", 
        RowBox[{"z", "[", "t", "]"}]}]}]}]}], "\n", "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[590]:=",ExpressionUUID->"12bfaac2-c85f-4bef-abfc-008b49ea935e"],


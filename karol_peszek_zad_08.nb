    RowBox[{"(", 
     RowBox[{
      RowBox[{"u\:017cycie", " ", "NDSolve"}], "-", 
      RowBox[{
      "NDSolve", " ", "mo\:017ce", " ", "rozwi\:0105zywa\[CAcute]", " ", 
       "zadania", " ", "brzegowe"}]}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{"rozwiazanieNDSolve9", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rownanie9", ",", "warunkibrzegowe9"}], "}"}], ",", "y", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"funkcja9", "[", "x_", "]"}], "=", 
    RowBox[{
     RowBox[{"y", "[", "x", "]"}], "/.", " ", 
     RowBox[{"First", "[", "rozwiazanieNDSolve9", "]"}]}]}]}]}]], "Input",

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definicja", " ", "r\[OAcute]wnania", " ", "r\[OAcute]\:017cniczkowego", " ",
     "i", " ", "warunk\[OAcute]w", " ", "brzegowych"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"rownanie9", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "''"}], "[", "x", "]"}], "+", 
       RowBox[{
        RowBox[{"Pi", "^", "2"}], "*", 
        RowBox[{"y", "[", "x", "]"}]}]}], "==", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", "*", "x"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"warunkibrzegowe9", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "1", "]"}], "==", "0"}]}], "}"}]}], 
    ";"}]}]}]], "Input",

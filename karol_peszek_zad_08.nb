     RowBox[{"u\:017cycie", " ", "DSolve"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"rozwiazanieDSolve2", "=", 
    RowBox[{"DSolve", "[", 
     RowBox[{"rownanie2", ",", 
      RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}]}], "\n", 
   RowBox[{"(*", 

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Definicja", " ", "parametr\[OAcute]w"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"K", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"y0", "=", "1"}], ";"}]}]}]], "Input",
 CellChangeTimes->{3.97308535322029*^9},
 CellLabel->
  "In[207]:=",ExpressionUUID->"ebc86e3e-482f-4794-a03d-8f7e9d452652"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definicja", " ", "r\[OAcute]wnania", " ", "r\[OAcute]\:017cniczkowego", " ",
     "i", " ", "warunku", " ", "pocz\:0105tkowego"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"rownanie6", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
      RowBox[{"r", "*", 
       RowBox[{"y", "[", "t", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"y", "[", "t", "]"}], "/", "K"}]}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"warunekpoczatkowy6", "=", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", "y0"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9730853593168497`*^9, 3.9730853593185787`*^9}},
 CellLabel->
  "In[210]:=",ExpressionUUID->"5e359883-1d0c-4317-85b0-d0447bfb9427"],


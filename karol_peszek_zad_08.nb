 CellChangeTimes->{{3.973084363297319*^9, 
  3.973084366807782*^9}},ExpressionUUID->"b25c0598-fe02-4ec9-bcf9-\
25de1db1514d"],

Cell["Zadanie 1.", "Text",
 CellChangeTimes->{{3.973084374552269*^9, 
  3.9730843757166157`*^9}},ExpressionUUID->"7e6be63a-bf95-4ddd-b304-\
eb8e59a130d4"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.973084813739251*^9, 3.973084813741872*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"019413fc-00a1-415e-8545-1b427e03f777"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definicja", " ", "r\[OAcute]wnania", " ", "r\[OAcute]\:017cniczkowego", " ",
     "i", " ", "warunku", " ", "pocz\:0105tkowego"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rownanie1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "x", "]"}], "==", 
      RowBox[{
       RowBox[{"y", "[", "x", "]"}], "*", 
       RowBox[{"Cos", "[", "x", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"warunekpoczatkowy1", "=", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", "1"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.973084818164463*^9, 3.9730848204013166`*^9}},
 CellLabel->
  "In[166]:=",ExpressionUUID->"dfcdf87d-e3dc-4c60-9e78-6dfdf90f7fff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Rozwi\:0105zanie", " ", "symboliczne", " ", 
    RowBox[{"(", 
     RowBox[{
     "mo\:017cna", " ", "u\:017cy\[CAcute]", " ", "DSolve", " ", "dla", " ", 
      "tego", " ", "typu", " ", "r\[OAcute]wnania"}], ")"}]}], "*)"}], 
  RowBox[{"rozwiazanieDSolve1", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rownanie1", ",", "warunekpoczatkowy1"}], "}"}], ",", 
     RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.973084829875164*^9, 3.973084829877355*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"55fcb602-fac0-4e03-b871-3d0b0048b09c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"Sin", "[", "x", "]"}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.973084830243402*^9},
 CellLabel->
  "Out[168]=",ExpressionUUID->"f0a254d5-bd9a-43d1-ad8d-216800536826"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Zapisanie", " ", "rozwi\:0105zania", " ", "jako", " ", "funkcji", " ", 
    "dla", " ", "dalszych", " ", 
    RowBox[{"oblicze\:0144", "/", "wykres\[OAcute]w"}]}], "*)"}], 
  RowBox[{
   RowBox[{"funkcja1", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "/.", " ", 
    RowBox[{"First", "[", "rozwiazanieDSolve1", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.973084833894508*^9, 3.9730848338970213`*^9}},
 CellLabel->
  "In[169]:=",ExpressionUUID->"e37a7500-fe29-45a6-bbee-845af5d60799"],

Cell[BoxData[
 SuperscriptBox["\[ExponentialE]", 
  RowBox[{"Sin", "[", "x", "]"}]]], "Output",
 CellChangeTimes->{3.973084834244472*^9},
 CellLabel->
  "Out[169]=",ExpressionUUID->"43734d4d-5a5c-46d3-a363-b595d51c3989"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Wykres", " ", "rozwi\:0105zania", " ", "dla", " ", "x", " ", "od", " ", 
    "0", " ", "do", " ", "10"}], "*)"}], 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"funkcja1", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
    RowBox[{
    "PlotLabel", "->", "\"\<Rozwi\:0105zanie r\[OAcute]wnania 1\>\""}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y(x)\>\""}], "}"}]}], ",", 
    RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}]], "Input",

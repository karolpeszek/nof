Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{"10", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"t", "/", "2"}]]}], 
     RowBox[{"9", "+", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"t", "/", "2"}]]}]]}], "}"}], "}"}]], "Output",

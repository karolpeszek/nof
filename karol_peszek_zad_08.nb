Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Rozwi\:0105zanie", " ", "symboliczne", " ", 
    RowBox[{"(", 
     RowBox[{"u\:017cycie", " ", "DSolve"}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{"rozwiazanieDSolve6", "=", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rownanie6", ",", "warunekpoczatkowy6"}], "}"}], ",", 
      RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"funkcja6", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "/.", " ", 
     RowBox[{"First", "[", "rozwiazanieDSolve6", "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9730853649709806`*^9, 3.9730853649734507`*^9}},

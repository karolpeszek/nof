Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Definicja", " ", "parametr\[OAcute]w"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"alpha", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta", "=", "0.1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gamma", "=", "1.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"delta", "=", "0.075"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.973085483822098*^9, 3.973085483825035*^9}},
 CellLabel->
  "In[228]:=",ExpressionUUID->"a119ca38-d3ac-4511-b99a-4fb0d11b0a9b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definicja", " ", "uk\[LSlash]adu", " ", "r\[OAcute]wna\:0144", " ", "i", " ",
     "warunk\[OAcute]w", " ", "pocz\:0105tkowych"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"uklad8", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"alpha", "*", 
          RowBox[{"x", "[", "t", "]"}]}], "-", 
         RowBox[{"beta", "*", 
          RowBox[{"x", "[", "t", "]"}], "*", 
          RowBox[{"y", "[", "t", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "gamma"}], "*", 
          RowBox[{"y", "[", "t", "]"}]}], "+", 
         RowBox[{"delta", "*", 
          RowBox[{"x", "[", "t", "]"}], "*", 
          RowBox[{"y", "[", "t", "]"}]}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"warunkipoczatkowe8", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "40"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "9"}]}], "}"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.97308548994633*^9, 3.973085489948453*^9}},
 CellLabel->
  "In[232]:=",ExpressionUUID->"caeb265c-3b76-4a0b-ae65-615c4ba563f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Rozwi\:0105zanie", " ", "numeryczne", " ", 
    RowBox[{"(", 
     RowBox[{"u\:017cycie", " ", "NDSolve"}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{"rozwiazanieNDSolve8", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"uklad8", ",", "warunkipoczatkowe8"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "50"}], "}"}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"funkcjakrok8", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "/.", " ", 
     RowBox[{"First", "[", "rozwiazanieNDSolve8", "]"}]}]}], "\n", 
   RowBox[{
    RowBox[{"funkcjapredator8", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "/.", " ", 
     RowBox[{"First", "[", "rozwiazanieNDSolve8", "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.97308549409905*^9, 3.9730854941017513`*^9}},
 CellLabel->

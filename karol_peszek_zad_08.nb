Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Przyk\[LSlash]ad", ":", 
     RowBox[{
     "narysowanie", " ", "rozwi\:0105zania", " ", "dla", " ", "warunku", " ", 

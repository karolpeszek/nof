Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Definicja", " ", "r\[OAcute]wnania", " ", "r\[OAcute]\:017cniczkowego", " ",
     "i", " ", "warunk\[OAcute]w", " ", "pocz\:0105tkowych"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"rownanie7", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "''"}], "[", "t", "]"}], "+", 
       RowBox[{"delta", "*", 
        RowBox[{
         RowBox[{"y", "'"}], "[", "t", "]"}]}], "+", 
       RowBox[{"alpha", "*", 
        RowBox[{"y", "[", "t", "]"}]}], "+", 
       RowBox[{"beta", "*", 
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], "^", "3"}]}]}], "==", 
      RowBox[{"gamma", "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"omega", "*", "t"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"warunekpoczatkowy7a", "=", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", 
      RowBox[{"1", "/", "10"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"warunekpoczatkowy7b", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}]}], ";"}]}]}]], "Input",\


     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rownanie7", ",", "warunekpoczatkowy7a", ",", "warunekpoczatkowy7b"}], 
       "}"}], ",", "y", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"funkcja7", "[", "t_", "]"}], "=", 

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Definicja", " ", "parametr\[OAcute]w"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"delta", "=", 
     RowBox[{"1", "/", "5"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alpha", "=", 
     RowBox[{"-", "1"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta", "=", "1.7"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gamma", "=", 
     RowBox[{"3", "/", "10"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omega", "=", 
     RowBox[{"6", "/", "5"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.973085384799837*^9, 3.973085384802424*^9}},
 CellLabel->

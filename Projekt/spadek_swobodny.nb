      RowBox[{
       RowBox[{"{", 
        RowBox[{"h0", ",", "v0", ",", "m"}], "}"}], "=", 
       RowBox[{"Values", "@", "defaultsNoDrag"}]}], ";"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ControlPlacement", "->", "Top"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",

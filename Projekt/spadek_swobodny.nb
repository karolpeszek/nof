Cell[CellGroupData[{

Cell["2. Spadek swobodny z oporem liniowym", "Section",
 CellChangeTimes->{
  3.974650286943666*^9, {3.974651051604516*^9, 
   3.974651051953759*^9}},ExpressionUUID->"5d718978-df3d-4d2c-9325-\
21052fabecff"],

Cell["\<\
Grawitacja + si\[LSlash]a oporu proporcjonalna do pr\:0119dko\:015bci \
(parametr k). Widzimy, jak op\[OAcute]r wyd\[LSlash]u\:017ca czas spadku i \
powoduje straty energii. Suwaki: wysoko\:015b\[CAcute], pr\:0119dko\:015b\
\[CAcute] pocz\:0105tkowa, masa, k; reset przywraca domy\:015blne.\
\>", "Text",
 CellChangeTimes->{{3.9746502967543383`*^9, 
  3.974650297974841*^9}},ExpressionUUID->"55c6871f-a2b9-4c7b-bcf3-\
a34df64c6930"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gConst", "=", "9.81"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"defaultsLin", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<h0\>\"", "->", "50"}], ",", 
      RowBox[{"\"\<v0\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<m\>\"", "->", "0.2"}], ",", 
      RowBox[{"\"\<k\>\"", "->", "0.4"}]}], "|>"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vFun", ",", "aFun", ",", "yFun", ",", "tImpact", ",", "eLoss", ",", 
       "pY", ",", "pV", ",", "pA"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"vFun", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"gConst", " ", "m"}], ")"}]}], "/", "k"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"v0", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"gConst", " ", "m"}], ")"}], "/", "k"}]}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"k", "/", "m"}], ")"}]}], " ", "t"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"aFun", "[", "t_", "]"}], ":=", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"vFun", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"yFun", "[", "t_", "]"}], ":=", 
       RowBox[{"h0", "+", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{"vFun", "[", "\[Tau]", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Tau]", ",", "0", ",", "t"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tImpact", "=", 
       RowBox[{"t", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"yFun", "[", "t", "]"}], "==", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "3"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"eLoss", "[", "t_", "]"}], ":=", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"k", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"vFun", "[", "\[Tau]", "]"}], ")"}], "^", "2"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", "0", ",", "t"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pY", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"yFun", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tImpact"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<y(t) [m]\>\""}], ",", 
         RowBox[{"ImageSize", "->", "650"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pV", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"vFun", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tImpact"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<v(t) [m/s]\>\""}], ",", 
         RowBox[{"ImageSize", "->", "650"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pA", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"aFun", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tImpact"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<a(t) [m/s^2]\>\""}], ",", 
         RowBox[{"ImageSize", "->", "650"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotStyle", "->", "Orange"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Spadek swobodny z oporem liniowym\>\"", ",", "14", ",",
            "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Grid", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<Czas spadku [s]\>\"", ",", 
              RowBox[{"N", "[", "tImpact", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\"\<Strata energii [J]\>\"", ",", 
              RowBox[{"N", "[", 
               RowBox[{"eLoss", "[", "tImpact", "]"}], "]"}]}], "}"}]}], 
           "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"GraphicsGrid", "[", 
          RowBox[{

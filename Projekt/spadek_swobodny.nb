  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "yFun", ",", "vFun", ",", "aFun", ",", "tImpact", ",", "pY", ",", "pV", 
       ",", "pA"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"yFun", "[", "t_", "]"}], ":=", 
       RowBox[{"h0", "+", 
        RowBox[{"v0", " ", "t"}], "-", 
        RowBox[{"0.5", " ", "gConst", " ", 
         RowBox[{"t", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vFun", "[", "t_", "]"}], ":=", 
       RowBox[{"v0", "-", 
        RowBox[{"gConst", " ", "t"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"aFun", "[", "t_", "]"}], ":=", 
       RowBox[{"-", "gConst"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tImpact", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"v0", "+", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"v0", "^", "2"}], "+", 
            RowBox[{"2", " ", "gConst", " ", "h0"}]}], "]"}]}], ")"}], "/", 
        "gConst"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pY", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"yFun", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tImpact"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<y(t) [m]\>\""}], ",", 
         RowBox[{"ImageSize", "->", "650"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pV", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"vFun", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tImpact"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<v(t) [m/s]\>\""}], ",", 
         RowBox[{"ImageSize", "->", "650"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pA", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"aFun", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tImpact"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<a(t) [m/s^2]\>\""}], ",", 
         RowBox[{"ImageSize", "->", "650"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotStyle", "->", "Orange"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Spadek swobodny bez oporu\>\"", ",", "14", ",", 
           "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Grid", "[", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"\"\<Czas spadku [s]\>\"", ",", 
             RowBox[{"N", "[", "tImpact", "]"}]}], "}"}], "}"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"GraphicsGrid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"pY", ",", "pV", ",", "pA"}], "}"}], "}"}], ",", 
           RowBox[{"Spacings", "->", 
            RowBox[{"{", 
             RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], "}"}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h0", ",", 
       RowBox[{"defaultsNoDrag", "[", "\"\<h0\>\"", "]"}], 
       ",", "\"\<h0 [m]\>\""}], "}"}], ",", "0", ",", "120", ",", "1"}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v0", ",", 
       RowBox[{"defaultsNoDrag", "[", "\"\<v0\>\"", "]"}], 
       ",", "\"\<v0 [m/s]\>\""}], "}"}], ",", 
     RowBox[{"-", "30"}], ",", "60", ",", "1"}], "}"}], ",", 
   "\[IndentingNewLine]", 

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gConst", "=", "9.81"}], ";", 
  RowBox[{
   RowBox[{"deg", "[", "x_", "]"}], ":=", 
   RowBox[{"x", " ", "Degree"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"defaultsLinProj", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<v0\>\"", "->", "25"}], ",", 
      RowBox[{"\"\<angle\>\"", "->", "45"}], ",", 
      RowBox[{"\"\<hTower\>\"", "->", "30"}], ",", 
      RowBox[{"\"\<m\>\"", "->", "0.2"}], ",", 
      RowBox[{"\"\<k\>\"", "->", "0.25"}]}], "|>"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vx0", ",", "vy0", ",", "vxFun", ",", "vyFun", ",", "axFun", ",", 
       "ayFun", ",", "xPos", ",", "yPos", ",", "tImpact", ",", "eLoss", ",", 
       "pX", ",", "pY", ",", "pVx", ",", "pVy", ",", "pAx", ",", "pAy"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vx0", "=", 
       RowBox[{"v0", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"deg", "[", "angle", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vy0", "=", 
       RowBox[{"v0", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"deg", "[", "angle", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vxFun", "[", "t_", "]"}], ":=", 
       RowBox[{"vx0", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"k", "/", "m"}], ")"}]}], " ", "t"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vyFun", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"gConst", " ", "m"}], ")"}]}], "/", "k"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"vy0", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"gConst", " ", "m"}], ")"}], "/", "k"}]}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"k", "/", "m"}], ")"}]}], " ", "t"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"axFun", "[", "t_", "]"}], ":=", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"vxFun", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ayFun", "[", "t_", "]"}], ":=", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"vyFun", "[", "t", "]"}], ",", "t"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"define", " ", "expression", " ", "for", " ", "any", " ", "x"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"expr", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sin", "[", "x", "]"}], ")"}], "^", "8"}]}], "+", 
      RowBox[{"4", " ", 

       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", " ", "x"}], "]"}], ")"}], "^", "4"}]}], "-", 
      RowBox[{"3", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Cos", "[", "x", "]"}], ")"}], "^", "8"}]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Cos", "[", "x", "]"}], ")"}], "^", "6"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "evaulate", " ", "the", " ", "expression", " ", "for", " ", "x"}], "=", 
     "117"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"expr", "/.", " ", 
      RowBox[{"x", "->", "117."}]}], ",", "20"}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",

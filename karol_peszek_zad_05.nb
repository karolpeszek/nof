Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "wektor", " ", "jednostkowy", " ", "osi", " ", "podany", " ", "przez", " ",
     "alfa", " ", 
    RowBox[{"(", "polar", ")"}], " ", "i", " ", "beta", " ", 

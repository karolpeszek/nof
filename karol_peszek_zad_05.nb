Cell[BoxData[
 RowBox[{"IalphaBeta", "=", 
  RowBox[{
   RowBox[{"sigma", "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"nx", "*", "x"}], "+", 
           RowBox[{"ny", "*", "y"}]}], ")"}], "^", "2"}]}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{
         RowBox[{"-", "a"}], "/", "2"}], ",", 
        RowBox[{"a", "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{
         RowBox[{"-", "b"}], "/", "2"}], ",", 
        RowBox[{"b", "/", "2"}]}], "}"}]}], "]"}]}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.971772943750852*^9, 3.9717729437530727`*^9}, {
  3.97177306890261*^9, 3.9717730703216677`*^9}},

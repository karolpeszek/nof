Cell[BoxData[
 RowBox[{
  FractionBox["1", "12"], " ", "M", " ", 
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["a", "2"], "+", 
    SuperscriptBox["b", "2"], "-", 
    RowBox[{
     SuperscriptBox["a", "2"], " ", 
     SuperscriptBox[
